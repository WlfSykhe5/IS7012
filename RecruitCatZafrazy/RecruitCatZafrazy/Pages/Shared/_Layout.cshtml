<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - NexaBridge Consulting</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-light main-navbar">
        <div class="container">

            <a class="navbar-brand" asp-area="" asp-page="/Index">
                NexaBridge Consulting
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-page="/OurTeam">
                            Our Team
                        </a>
                    </li>

                </ul>

            </div>

        </div>
    </nav>


    <main>
        @RenderBody()
    </main>


    <footer class="site-footer">
        <div class="container">

            <p>
                &copy; @DateTime.Now.Year - NexaBridge Consulting
            </p>

            <p style="font-size: 12px;">
                Images used on this website were generated with ChatGPT (OpenAI) for this assignment.
            </p>

        </div>
    </footer>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>