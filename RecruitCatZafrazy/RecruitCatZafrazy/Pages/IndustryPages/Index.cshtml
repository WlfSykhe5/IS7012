@page
@model RecruitCatZafrazy.Pages.IndustryPages.IndexModel

@{
    ViewData["Title"] = "All Industries";
}

<h1>All Industries</h1>

<p class="mt-3 mb-4">
    <a asp-page="Create" class="btn-theme">
        Add Industry
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Industry[0].IndustryName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Industry[0].Description)
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Industry)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.IndustryName)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Description)
                </td>
                <td class="text-nowrap">
                    <a asp-page="./Details"
                       asp-route-id="@item.IndustryId"
                       class="btn-theme-outline me-2">
                        Details
                    </a>

                    <a asp-page="./Edit"
                       asp-route-id="@item.IndustryId"
                       class="btn-theme me-2">
                        Edit
                    </a>

                    <a asp-page="./Delete"
                       asp-route-id="@item.IndustryId"
                       class="btn-delete">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>