@page
@model IndexModel

<!-- HERO -->

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6">

                <div class="hero-content">

                    <span class="hero-label">
                        Dubai-based recruitment specialists
                    </span>

                    <h1 class="hero-title">
                        Connecting the right people with the right opportunities.
                    </h1>

                    <p class="hero-text">
                        We connects qualified professionals with growing businesses across the UAE.

                        We provide practical recruitment support for both employers and job seekers across a range of industries.
                    </p>

                    <div class="hero-actions">

                        <div class="primary-action">
                            <a href="#services" class="btn btn-main">
                                Explore Our Services
                            </a>
                        </div>

                        <div class="secondary-actions">
                            <a href="#industries" class="btn btn-outline-main">
                                Industries We Serve
                            </a>

                            <a href="#apply" class="btn btn-outline-main">
                                How to Apply
                            </a>

                            <a href="#testimonials" class="btn btn-outline-main">
                                Testimonials
                            </a>
                        </div>

                    </div>


                </div>

            </div>


            <div class="col-lg-6">

                <img src="~/images/hero-recruitment.png"
                     class="hero-image"
                     alt="Modern recruitment office">

            </div>

        </div>

    </div>

</section>

<section id="services" class="page-section section-light">

    <div class="container">

        <div class="section-heading">

            <h2 class="section-title">
                Our Services
            </h2>

        </div>

        <div class="row g-4">

            <div class="col-md-4">

                <div class="service-card">

                    <h3>Permanent Recruitment</h3>

                    <p>
                        We help companies identify and hire qualified professionals for permanent positions.
                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="service-card">

                    <h3>Temporary and Contract Staffing</h3>

                    <p>
                        Flexible staffing support for project-based requirements, short-term assignments, and temporary workforce needs.

                    </p>

                </div>

            </div>


            <div class="col-md-4">

                <div class="service-card">

                    <h3>Candidate Screening</h3>

                    <p>
                        Initial resume review, candidate screening, and interview coordination to help employers focus on the most suitable applicants.

                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="service-card">

                    <h3>Executive Search</h3>

                    <p>
                        Targeted recruitment support for experienced professionals, managers, and specialist positions.

                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="service-card">

                    <h3>Recruitment Process Support</h3>

                    <p>
                        We assist employers with job advertisements, applicant management, interview scheduling, and candidate communication.

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<section id="industries" class="page-section">

    <div class="container">

        <h2 class="section-title">
            Industries We Specialize In
        </h2>

        <div>

            <span class="industry-tag">Aviation and Travel</span>
            <span class="industry-tag">Finance and Accounting</span>
            <span class="industry-tag">Information Technology</span>
            <span class="industry-tag">Logistics and Supply Chain</span>
            <span class="industry-tag">Engineering and Technical Services</span>
            <span class="industry-tag">Hospitality and Customer Service</span>
        </div>

    </div>

</section>

<section id="apply" class="page-section section-light">

    <div class="container">

        <h2 class="section-title">
            Looking for your next career move?
        </h2>

        <div class="process-step">

            <div class="step-number">
                Step 01
            </div>

            <h4>Create Your Profile</h4>

            <p>
                Register through our online recruitment portal and provide your contact information, experience, skills, and career interests.
            </p>

        </div>


        <div class="process-step">

            <div class="step-number">
                Step 02
            </div>

            <h4>Upload Your Resume</h4>

            <p>
                Upload your latest resume so our recruitment team can review your qualifications.
            </p>

        </div>


        <div class="process-step">

            <div class="step-number">
                Step 03
            </div>

            <h4>Search Available Jobs</h4>

            <p>
                Browse current opportunities by industry, location, or job category.
            </p>

        </div>
        <div class="process-step">

            <div class="step-number">
                Step 04
            </div>

            <h4>Apply Online</h4>

            <p>
                Select the position that matches your experience and submit your application directly through the website.

            </p>

        </div>

        <div class="process-step">

            <div class="step-number">
                Step 05
            </div>

            <h4>Speak With Our Recruitment Team</h4>

            <p>
                If your profile matches an opportunity, one of our consultants will contact you to discuss the position and next steps.
            </p>

        </div>

        <div class="process-step">

            <div class="step-number">
                Step 06
            </div>

            <h4>Interview and Follow-Up</h4>

            <p>
                We coordinate interviews with employers and keep you informed throughout the recruitment process.
            </p>

        </div>

    </div>

</section>

