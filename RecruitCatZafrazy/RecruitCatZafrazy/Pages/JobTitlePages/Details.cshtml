@page
@model RecruitCatZafrazy.Pages.JobTitlePages.DetailsModel

@{
    ViewData["Title"] = "Job Title Details";
}

<h1>Job Title Details</h1>

<hr />

<dl class="row">

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.JobTitle.JobTitleName)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.JobTitle.JobTitleName)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.JobTitle.EmploymentType)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.JobTitle.EmploymentType)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.JobTitle.MinimumSalary)
    </dt>
    <dd class="col-sm-10">
        @Model.JobTitle.MinimumSalary.ToString("N2")
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.JobTitle.MaximumSalary)
    </dt>
    <dd class="col-sm-10">
        @Model.JobTitle.MaximumSalary.ToString("N2")
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.JobTitle.JobOffer)
    </dt>
    <dd class="col-sm-10">
        @Model.JobTitle.JobOffer.ToString("N2")
    </dd>

</dl>

<div>
    <a asp-page="./Edit"
       asp-route-id="@Model.JobTitle.JobTitleId"
       class="btn btn-primary me-3">
        Edit
    </a>

    <a asp-page="./Index">Back to List</a>
</div>