@page
@model RecruitCatZafrazy.Pages.JobTitlePages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>JobTitle</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="JobTitle.JobTitleId" />
            <div class="form-group">
                <label asp-for="JobTitle.JobTitleName" class="control-label"></label>
                <input asp-for="JobTitle.JobTitleName" class="form-control" />
                <span asp-validation-for="JobTitle.JobTitleName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="JobTitle.MinimumSalary" class="control-label"></label>
                <input asp-for="JobTitle.MinimumSalary" class="form-control" />
                <span asp-validation-for="JobTitle.MinimumSalary" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="JobTitle.MaximumSalary" class="control-label"></label>
                <input asp-for="JobTitle.MaximumSalary" class="form-control" />
                <span asp-validation-for="JobTitle.MaximumSalary" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="JobTitle.EmploymentType" class="control-label"></label>
                <input asp-for="JobTitle.EmploymentType" class="form-control" />
                <span asp-validation-for="JobTitle.EmploymentType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="JobTitle.JobOffer" class="control-label"></label>
                <input asp-for="JobTitle.JobOffer" class="form-control" />
                <span asp-validation-for="JobTitle.JobOffer" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
