@page
@model RecruitCatZafrazy.Pages.JobTitlePages.DeleteModel

@{
    ViewData["Title"] = "Delete Job Title";
}

<h1>Delete Job Title</h1>

<h3>
    Are you sure you want to delete @Model.JobTitle.JobTitleName?
</h3>

<hr />

<dl class="row">

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.JobTitle.JobTitleName)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.JobTitle.JobTitleName)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.JobTitle.EmploymentType)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.JobTitle.EmploymentType)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.JobTitle.MinimumSalary)
    </dt>
    <dd class="col-sm-10">
        @Model.JobTitle.MinimumSalary.ToString("N2")
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.JobTitle.MaximumSalary)
    </dt>
    <dd class="col-sm-10">
        @Model.JobTitle.MaximumSalary.ToString("N2")
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.JobTitle.JobOffer)
    </dt>
    <dd class="col-sm-10">
        @Model.JobTitle.JobOffer.ToString("N2")
    </dd>

</dl>

<form method="post">

    <input type="hidden"
           asp-for="JobTitle.JobTitleId" />

    <input type="submit"
           value="Delete"
           class="btn btn-danger me-3" />

    <a asp-page="./Index">Back to List</a>

</form>