@page
@model RecruitCatZafrazy.Pages.CandidatePages.IndexModel

@{
    ViewData["Title"] = "All Candidates";
}

<h1>All Candidates</h1>

<p class="mt-3 mb-4">
    <a asp-page="Create" class="btn-theme-outline">
        Add Candidate
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                First Name
            </th>

            <th>
                Last Name
            </th>

            <th>
                Job Title
            </th>

            <th>
                Industry
            </th>

            <th>
                Company
            </th>

            <th>
                Target Salary (USD)
            </th>

            <th>
                Start Date
            </th>

            <th>
                Actions
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Candidate)
        {
            <tr>
                <td>
                    @item.FirstName
                </td>

                <td>
                    @item.LastName
                </td>

                <td>
                    @item.JobTitle?.JobTitleName
                </td>

                <td>
                    @item.Industry?.IndustryName
                </td>

                <td>
                    @item.Company?.CompanyName
                </td>

                <td>
                    @item.TargetSalary.ToString("N2")
                </td>

                <td>
                    @if (item.StartDate.HasValue)
                    {
                        @item.StartDate.Value.ToString("d MMM yyyy")
                    }
                </td>

                <td class="text-nowrap">
                    <a asp-page="./Details"
                       asp-route-id="@item.CandidateId"
                       class="btn-theme-outline me-2">
                        Details
                    </a>

                    <a asp-page="./Edit"
                       asp-route-id="@item.CandidateId"
                       class="btn-theme-outline me-2">
                        Edit
                    </a>

                    <a asp-page="./Delete"
                       asp-route-id="@item.CandidateId"
                       class="btn-delete">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>