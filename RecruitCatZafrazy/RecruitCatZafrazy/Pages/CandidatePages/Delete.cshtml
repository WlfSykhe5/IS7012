@page
@model RecruitCatZafrazy.Pages.CandidatePages.DeleteModel

@{
    ViewData["Title"] = "Delete Candidate";
}

<h1>Delete Candidate</h1>

<h3>
    Are you sure you want to delete
    @Model.Candidate.FirstName @Model.Candidate.LastName?
</h3>

<hr />

<dl class="row">

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Candidate.FirstName)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Candidate.FirstName)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Candidate.LastName)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Candidate.LastName)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Candidate.Email)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Candidate.Email)
    </dd>

    <dt class="col-sm-2">
        Company
    </dt>
    <dd class="col-sm-10">
        @Model.Candidate.Company?.CompanyName
    </dd>

    <dt class="col-sm-2">
        Job Title
    </dt>
    <dd class="col-sm-10">
        @Model.Candidate.JobTitle?.JobTitleName
    </dd>

    <dt class="col-sm-2">
        Industry
    </dt>
    <dd class="col-sm-10">
        @Model.Candidate.Industry?.IndustryName
    </dd>

</dl>

<form method="post">

    <input type="hidden" asp-for="Candidate.CandidateId" />

    <input type="submit"
           value="Delete"
           class="btn btn-danger" />

    <a asp-page="./Index">Back to List</a>

</form>