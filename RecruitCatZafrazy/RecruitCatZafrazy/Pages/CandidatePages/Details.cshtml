@page
@model RecruitCatZafrazy.Pages.CandidatePages.DetailsModel

@{
    ViewData["Title"] = "Candidate Details";
}

<h1>Candidate Details</h1>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Candidate.FirstName)
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.Candidate.FirstName)
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Candidate.LastName)
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.Candidate.LastName)
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Candidate.DateOfBirth)
    </dt>
    <dd class="col-sm-9">
        @Model.Candidate.DateOfBirth.ToString("d MMM yyyy")
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Candidate.Email)
    </dt>
    <dd class="col-sm-9">
        <a href="mailto:@Model.Candidate.Email">
            @Model.Candidate.Email
        </a>
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Candidate.PhoneNumber)
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.Candidate.PhoneNumber)
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Candidate.TargetSalary)
    </dt>
    <dd class="col-sm-9">
        @Model.Candidate.TargetSalary.ToString("N2")
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Candidate.StartDate)
    </dt>
    <dd class="col-sm-9">
        @if (Model.Candidate.StartDate.HasValue)
        {
            @Model.Candidate.StartDate.Value.ToString("d MMM yyyy")
        }
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Candidate.NoticePeriodRequired)
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.Candidate.NoticePeriodRequired)
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Candidate.NoticePeriodDays)
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.Candidate.NoticePeriodDays)
    </dd>

    <dt class="col-sm-3">
        Company
    </dt>
    <dd class="col-sm-9">
        @Model.Candidate.Company?.CompanyName
    </dd>

    <dt class="col-sm-3">
        Job Title
    </dt>
    <dd class="col-sm-9">
        @Model.Candidate.JobTitle?.JobTitleName
    </dd>

    <dt class="col-sm-3">
        Industry
    </dt>
    <dd class="col-sm-9">
        @Model.Candidate.Industry?.IndustryName
    </dd>

</dl>

<div class="mt-4">
    <a asp-page="./Edit"
       asp-route-id="@Model.Candidate.CandidateId"
       class="btn-theme-outline">
        Edit
    </a>
</div>

<div class="mt-3">
    <a asp-page="./Index">Back to List</a>
</div>