@page
@model RecruitCatZafrazy.Pages.CompanyPages.CreateModel

@{
    ViewData["Title"] = "Create Company";
}

<h1>Create Company</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="form-group">
                <label asp-for="Company.CompanyName"></label>
                <input asp-for="Company.CompanyName"
                       class="form-control" />
                <span asp-validation-for="Company.CompanyName"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Company.MinimumSalary"></label>
                <input asp-for="Company.MinimumSalary"
                       class="form-control" />
                <span asp-validation-for="Company.MinimumSalary"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Company.MaximumSalary"></label>
                <input asp-for="Company.MaximumSalary"
                       class="form-control" />
                <span asp-validation-for="Company.MaximumSalary"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Company.StartDate"></label>
                <input asp-for="Company.StartDate"
                       class="form-control" />
                <span asp-validation-for="Company.StartDate"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Company.Location"></label>
                <textarea asp-for="Company.Location"
                          class="form-control"
                          rows="4"></textarea>
                <span asp-validation-for="Company.Location"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Company.Email"></label>
                <input asp-for="Company.Email"
                       class="form-control" />
                <span asp-validation-for="Company.Email"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Company.PhoneNumber"></label>
                <input asp-for="Company.PhoneNumber"
                       class="form-control" />
                <span asp-validation-for="Company.PhoneNumber"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Company.IncorporationDate"></label>
                <input asp-for="Company.IncorporationDate"
                       class="form-control" />
                <span asp-validation-for="Company.IncorporationDate"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Company.JobTitleId"></label>

                <select asp-for="Company.JobTitleId"
                        asp-items="ViewBag.JobTitleId"
                        class="form-control">

                    <option value="">-- Select Job Title --</option>

                </select>

                <span asp-validation-for="Company.JobTitleId"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Company.IndustryId"></label>

                <select asp-for="Company.IndustryId"
                        asp-items="ViewBag.IndustryId"
                        class="form-control">

                    <option value="">-- Select Industry --</option>

                </select>

                <span asp-validation-for="Company.IndustryId"
                      class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit"
                       value="Create"
                       class="btn-theme-outline" />
            </div>

        </form>

    </div>
</div>

<div class="mt-3">
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}