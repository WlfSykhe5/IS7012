@page
@model RecruitCatZafrazy.Pages.CompanyPages.DetailsModel

@{
    ViewData["Title"] = "Company Details";
}

<h1>Company Details</h1>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Company.CompanyName)
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.Company.CompanyName)
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Company.MinimumSalary)
    </dt>
    <dd class="col-sm-9">
        @Model.Company.MinimumSalary.ToString("N2")
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Company.MaximumSalary)
    </dt>
    <dd class="col-sm-9">
        @Model.Company.MaximumSalary.ToString("N2")
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Company.StartDate)
    </dt>
    <dd class="col-sm-9">
        @if (Model.Company.StartDate.HasValue)
        {
            @Model.Company.StartDate.Value.ToString("d MMM yyyy")
        }
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Company.Location)
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.Company.Location)
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Company.Email)
    </dt>
    <dd class="col-sm-9">
        <a href="mailto:@Model.Company.Email">
            @Model.Company.Email
        </a>
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Company.PhoneNumber)
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.Company.PhoneNumber)
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Company.IncorporationDate)
    </dt>
    <dd class="col-sm-9">
        @Model.Company.IncorporationDate.ToString("d MMM yyyy")
    </dd>

    <dt class="col-sm-3">
        Job Title
    </dt>
    <dd class="col-sm-9">
        @Model.Company.JobTitle?.JobTitleName
    </dd>

    <dt class="col-sm-3">
        Industry
    </dt>
    <dd class="col-sm-9">
        @Model.Company.Industry?.IndustryName
    </dd>

</dl>

<h3 class="mt-4">Candidates</h3>

@if (Model.Company.Candidates != null &&
     Model.Company.Candidates.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    First Name
                </th>

                <th>
                    Last Name
                </th>

                <th>
                    Email
                </th>

                <th>
                    Target Salary (USD)
                </th>
            </tr>
        </thead>

        <tbody>
            @foreach (var candidate in Model.Company.Candidates)
            {
                <tr>
                    <td>
                        @candidate.FirstName
                    </td>

                    <td>
                        @candidate.LastName
                    </td>

                    <td>
                        @candidate.Email
                    </td>

                    <td>
                        @candidate.TargetSalary.ToString("N2")
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No candidates are currently associated with this company.</p>
}

<div class="mt-4">
    <a asp-page="./Edit"
       asp-route-id="@Model.Company.CompanyId"
       class="btn-theme-outline">
        Edit
    </a>
</div>

<div class="mt-3">
    <a asp-page="./Index">Back to List</a>
</div>