@page
@model RecruitCatZafrazy.Pages.CompanyPages.IndexModel

@{
    ViewData["Title"] = "All Companies";
}

<h1>All Companies</h1>

<p class="mt-3 mb-4">
    <a asp-page="Create" class="btn-theme-outline">
        Add Company
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                Company Name
            </th>

            <th>
                Industry
            </th>

            <th>
                Job Title
            </th>

            <th>
                Minimum Asking Salary (USD)
            </th>

            <th>
                Maximum Asking Salary (USD)
            </th>

            <th>
                Start Date
            </th>

            <th>
                Incorporation Date
            </th>

            <th>
                Actions
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Company)
        {
            <tr>
                <td>
                    @item.CompanyName
                </td>

                <td>
                    @item.Industry?.IndustryName
                </td>

                <td>
                    @item.JobTitle?.JobTitleName
                </td>

                <td>
                    @item.MinimumSalary.ToString("N2")
                </td>

                <td>
                    @item.MaximumSalary.ToString("N2")
                </td>

                <td>
                    @if (item.StartDate.HasValue)
                    {
                        @item.StartDate.Value.ToString("d MMM yyyy")
                    }
                </td>

                <td>
                    @item.IncorporationDate.ToString("d MMM yyyy")
                </td>

                <td class="text-nowrap">
                    <a asp-page="./Details"
                       asp-route-id="@item.CompanyId"
                       class="btn-theme-outline me-2">
                        Details
                    </a>

                    <a asp-page="./Edit"
                       asp-route-id="@item.CompanyId"
                       class="btn-theme-outline me-2">
                        Edit
                    </a>

                    <a asp-page="./Delete"
                       asp-route-id="@item.CompanyId"
                       class="btn-delete">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>