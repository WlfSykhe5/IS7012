@page
@model RecruitCatZafrazy.Pages.CompanyPages.DeleteModel

@{
    ViewData["Title"] = "Delete Company";
}

<h1>Delete Company</h1>

<h3>
    Are you sure you want to delete @Model.Company.CompanyName?
</h3>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Company.CompanyName)
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.Company.CompanyName)
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Company.MinimumSalary)
    </dt>
    <dd class="col-sm-9">
        @Model.Company.MinimumSalary.ToString("N2")
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Company.MaximumSalary)
    </dt>
    <dd class="col-sm-9">
        @Model.Company.MaximumSalary.ToString("N2")
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Company.StartDate)
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.Company.StartDate)
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Company.Location)
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.Company.Location)
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Company.Email)
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.Company.Email)
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Company.PhoneNumber)
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.Company.PhoneNumber)
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Company.IncorporationDate)
    </dt>
    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.Company.IncorporationDate)
    </dd>

    <dt class="col-sm-3">
        Job Title
    </dt>
    <dd class="col-sm-9">
        @Model.Company.JobTitle?.JobTitleName
    </dd>

    <dt class="col-sm-3">
        Industry
    </dt>
    <dd class="col-sm-9">
        @Model.Company.Industry?.IndustryName
    </dd>

</dl>


<form method="post" class="mt-4">

    <input type="hidden"
           asp-for="Company.CompanyId" />

    <input type="submit"
           value="Delete"
           class="btn-delete" />

</form>

<div class="mt-3">
    <a asp-page="./Index">Back to List</a>
</div>